# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MAX_OUTPUT_TOKENS=16384

# DataForSEO (Basic auth: login + password from API credentials)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_LANGUAGE_CODE=en
DATAFORSEO_LOCATION_CODE=2356

# Public URL of the app in production (OAuth/WordPress callbacks)
APP_BASE_URL=https://app.blazly.ai

# App analytics (GA4 + Microsoft Clarity). Loaded in production only unless VITE_ANALYTICS_IN_DEV=true
VITE_GA4_MEASUREMENT_ID=G-P8ZCKHBJFV
VITE_CLARITY_PROJECT_ID=z789hqau27

# Brevo (email OTP verification)
BREVO_API_KEY=
BREVO_VERIFICATION_TEMPLATE_ID=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_PASSWORD_RESET_TEMPLATE_ID=

# Firebase Admin service account (JSON or base64) for password resets
FIREBASE_SERVICE_ACCOUNT=

# Stripe (fill in later)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
